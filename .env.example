# ============================================================
#  Helpix AI Backend - Environment Configuration EXAMPLE
#  Copy this file to .env and fill in your own values.
#  NEVER commit the actual .env file to version control!
# ============================================================

# --- App ---
APP_ENV=development
APP_VERSION=2.0.0

# --- MongoDB ---
# LOCAL:  MONGO_URL=mongodb://localhost:27017
# ATLAS:  MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=helpix_ai

# --- JWT Authentication ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AES Encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET_GENERATE_KEY

# --- File Storage ---
UPLOAD_DIR=uploads

# --- CORS (comma-separated list, use * for development only) ---
ALLOWED_ORIGINS=*

# --- Rate Limiting ---
RATE_LIMIT_STRICT_LIMIT=5
RATE_LIMIT_STRICT_WINDOW=60
RATE_LIMIT_MODERATE_LIMIT=30
RATE_LIMIT_MODERATE_WINDOW=60
RATE_LIMIT_LOOSE_LIMIT=100
RATE_LIMIT_LOOSE_WINDOW=60
RATE_LIMIT_BACKOFF_BASE=2
RATE_LIMIT_BACKOFF_MAX=3600

# --- Google OAuth ---
# Get from https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
